<?xml version="1.0" encoding="utf-8"?>
<!-- Botão comum do widget: contorno fino, cantos de 10 dp -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#337F9CF5">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="1dp" android:color="@color/it_dark_outline"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
</ripple>
