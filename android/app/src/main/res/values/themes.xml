<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base AppCompat: no Android 6 a 8.0 a biometria (androidx.biometric) abre uma janela AppCompat e fecharia o
         app se o tema fosse Material puro. Fundo escuro de fábrica (a tela troca pelo claro se essa for a escolha). -->
    <style name="Theme.Italock" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/it_dark_bg</item>
        <item name="colorPrimary">@color/italock_blue</item>
        <item name="colorPrimaryDark">@color/italock_blue</item>
        <item name="colorAccent">@color/italock_orange</item>
    </style>
    <!-- Telas transparentes (atalho rápido, widget, aprovação pela notificação): também AppCompat, pelo mesmo motivo. -->
    <style name="Theme.Italock.Transparent" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="colorPrimary">@color/italock_blue</item>
        <item name="colorAccent">@color/italock_orange</item>
    </style>
</resources>
