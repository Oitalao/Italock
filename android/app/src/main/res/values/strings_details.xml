    <!-- Recursos experimentais -->
    <string name="exp_title">Recursos experimentais</string>
    <string name="exp_banner">Experimental. Pode não funcionar direito, mudar ou sumir em versões futuras. Use por sua conta.</string>
    <string name="exp_nearby">Destravar automático quando perto</string>
    <string name="exp_nearby_sub">Por Bluetooth ou na mesma rede, sem tocar no celular (nunca pelo Tailscale). Risco: alguém ao lado do computador destrava.</string>
    <string name="exp_notification">Destravar pela notificação</string>
    <string name="exp_notification_sub">Botão Destravar na notificação, sem biometria. Risco: quem pegar o celular desbloqueado destrava.</string>
    <string name="exp_watch">Relógio Amazfit (chamada falsa)</string>
    <string name="exp_watch_sub">O pedido aparece no relógio como uma chamada: ignorar destrava, recusar nega. Fora do pulso, a ação é bloqueada. Precisa do Gadgetbridge Voz pareado ao relógio. Risco: quem estiver com seu relógio no pulso destrava.</string>
    <string name="exp_wear">Relógio Wear OS</string>
    <string name="exp_wear_sub">O pedido aparece no relógio (Galaxy Watch, Pixel Watch e outros) com Destravar e Recusar; o tile trava, destrava e liga. Precisa do app Ítalock no relógio e do bloqueio de tela ligado nele. Longe do celular, passa pela internet do Google. Risco: quem estiver com seu relógio desbloqueado destrava.</string>
    <string name="exp_footer">Depois de ligar, escolha os computadores nos detalhes de cada um. Desligar aqui desliga em todos.</string>

