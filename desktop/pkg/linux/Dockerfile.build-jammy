# Ítalock: ambiente de compilação Linux em Ubuntu 22.04 (glibc 2.35), para os binários rodarem em distros
# mais antigas que a máquina onde se compila. O Qt 6.10.2 (aqt) NÃO vai na imagem: é montado em /qt.
# Uso: pkg/linux/build-container.sh (constrói esta imagem na primeira vez).
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      g++-12 gcc-12 make ninja-build pkg-config git ca-certificates curl xz-utils p7zip-full python3-pip \
      libssl-dev libbluetooth-dev libcrypt-dev libpam0g-dev \
      libgl1-mesa-dev libegl1-mesa-dev libxkbcommon-dev libxkbcommon-x11-dev libfontconfig1-dev libfreetype6-dev \
      libx11-dev libx11-xcb-dev libxcb1-dev libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 \
      libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 libxcb-xkb1 libdbus-1-3 libglib2.0-0 \
  && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 100 \
  && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-12 100 \
  && update-alternatives --install /usr/bin/cc cc /usr/bin/gcc-12 100 \
  && update-alternatives --install /usr/bin/c++ c++ /usr/bin/g++-12 100 \
  && pip3 install --no-cache-dir "cmake>=3.28,<4" \
  && rm -rf /var/lib/apt/lists/*
